NODE_ENV=production
API_PORT=3000
DATABASE_URL=postgresql://bsc_app:<secret>@postgres:5432/bsc_staging?schema=public
JWT_ACCESS_SECRET=<at-least-32-random-characters>
JWT_REFRESH_SECRET=<different-at-least-32-random-characters>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_SAME_SITE=lax
CORS_ORIGIN=https://bsc-staging.example.com
VITE_API_BASE_URL=/api
REFRESH_COOKIE_PATH=/api/auth
TRUST_PROXY=1
LOG_LEVEL=info
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=<secret-manager-value-minimum-12-characters>
BOOTSTRAP_ADMIN_EMPLOYEE_CODE=ADMIN001
BOOTSTRAP_ADMIN_FULL_NAME=Quản trị hệ thống
BOOTSTRAP_ADMIN_DEPARTMENT_CODE=ROOT
BOOTSTRAP_ADMIN_DEPARTMENT_NAME=Đơn vị gốc
BOOTSTRAP_ADMIN_POSITION_CODE=SYS_ADMIN
BOOTSTRAP_ADMIN_POSITION_NAME=Chuyên viên hệ thống
BOOTSTRAP_ADMIN_POSITION_LEVEL=10
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MS=900000

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?  @db.Uuid
  module      String   @db.VarChar(100)
  entity_type String   @db.VarChar(100)
  entity_id   String?  @db.Uuid
  action      String   @db.VarChar(100)
  old_data    Json?
  new_data    Json?
  ip_address  String?  @db.VarChar(50)
  user_agent  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "audit_logs_user_fk")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bsc_approval_steps {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_bsc_id String       @db.Uuid
  stage           String       @db.VarChar(20)
  step_order      Int
  approver_id     String       @db.Uuid
  approver_role   String       @db.VarChar(30)
  status          String       @default("PENDING") @db.VarChar(20)
  comment         String?
  acted_at        DateTime?    @db.Timestamptz(6)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  users           users        @relation(fields: [approver_id], references: [id], onUpdate: NoAction, map: "bsc_approval_steps_approver_fk")
  employee_bsc    employee_bsc @relation(fields: [employee_bsc_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bsc_approval_steps_bsc_fk")

  @@unique([employee_bsc_id, stage, step_order], map: "bsc_approval_steps_stage_order_uq")
}

model bsc_attachments {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_bsc_id    String              @db.Uuid
  bsc_item_id        String?             @db.Uuid
  file_name          String              @db.VarChar(255)
  file_path          String
  mime_type          String              @db.VarChar(100)
  file_size          BigInt
  uploaded_by        String              @db.Uuid
  uploaded_at        DateTime            @default(now()) @db.Timestamptz(6)
  deleted_at         DateTime?           @db.Timestamptz(6)
  employee_bsc       employee_bsc        @relation(fields: [employee_bsc_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bsc_attachments_bsc_fk")
  employee_bsc_items employee_bsc_items? @relation(fields: [bsc_item_id], references: [id], onUpdate: NoAction, map: "bsc_attachments_item_fk")
  users              users               @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction, map: "bsc_attachments_uploaded_by_fk")
}


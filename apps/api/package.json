{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "dotenv -e ../../.env -- ts-node prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node ./test/run-tests.js",
    "prisma:test:deploy": "node ./test/run-organization-integration.js --deploy-only",
    "test:integration:organization": "node ./test/run-organization-integration.js",
    "test:integration:bsc-draft": "node ./test/run-bsc-draft-integration.js",
    "test:integration:bsc-scoring": "node ./test/run-bsc-scoring-integration.js",
    "test:integration:bsc-workflow": "node ./test/run-bsc-workflow-integration.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^26.1.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "prisma": "5.22.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "5.6.3"
  }
}

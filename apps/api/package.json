{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start:e2e": "node -r ts-node/register/transpile-only src/main.ts",
    "build": "nest build",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "dotenv -e ../../.env -- ts-node prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node ./test/run-tests.js",
    "prisma:test:deploy": "node ./test/run-organization-integration.js --deploy-only",
    "prisma:test:fresh-verify": "node ./test/verify-fresh-migrations.js",
    "test:integration:organization": "node ./test/run-organization-integration.js",
    "test:integration:bsc-draft": "node ./test/run-bsc-draft-integration.js",
    "test:integration:bsc-scoring": "node ./test/run-bsc-scoring-integration.js",
    "test:integration:bsc-dual-stage-workflow": "node ./test/run-bsc-dual-stage-workflow-integration.js",
    "test:integration:bsc-scoring-alignment": "node ./test/run-bsc-scoring-alignment-integration.js",
    "test:integration:bsc-reopen-version-duplicate": "node ./test/run-bsc-reopen-version-duplicate-integration.js",
    "test:integration:bsc-reports": "node ./test/run-bsc-reports-integration.js",
    "test:integration:bsc-authorization-scope": "node ./test/run-bsc-authorization-scope-integration.js",
    "test:integration:bsc-cycles": "node ./test/run-bsc-cycles-integration.js",
    "report:bsc-scoring-alignment": "dotenv -e ../../.env -- ts-node scripts/report-bsc-scoring-alignment.ts",
    "report:bsc-version-backfill": "dotenv -e ../../.env.test.local -e ../../.env -- ts-node scripts/report-bsc-version-backfill.ts"
    ,"report:bsc-workflow-backfill-issues": "dotenv -e ../../.env.test.local -e ../../.env -- ts-node scripts/report-bsc-workflow-backfill-issues.ts"
    ,"rehearsal:migration": "dotenv -e ../../.env.test.local -e ../../.env -- ts-node scripts/database-rehearsal.ts"
    ,"rehearsal:backup-restore": "dotenv -e ../../.env.test.local -e ../../.env -- ts-node scripts/database-rehearsal.ts --restore"
    ,"smoke:security": "dotenv -e ../../.env.test.local -e ../../.env -- ts-node scripts/security-smoke.ts"
    ,"uat:seed": "dotenv -e ../../.env.test.local -e ../../.env -- ts-node scripts/uat-fixture.ts"
    ,"uat:cleanup": "dotenv -e ../../.env.test.local -e ../../.env -- ts-node scripts/uat-fixture.ts --cleanup"
    ,"baseline:performance": "dotenv -e ../../.env.test.local -e ../../.env -- ts-node scripts/performance-baseline.ts"
    ,"performance:seed": "dotenv -e ../../.env.test.local -e ../../.env -- ts-node scripts/performance-fixture.ts"
    ,"performance:cleanup": "dotenv -e ../../.env.test.local -e ../../.env -- ts-node scripts/performance-fixture.ts --cleanup"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^26.1.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "prisma": "5.22.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "5.6.3"
  }
}
